# Nombre exacto del grupo de WhatsApp tal cual aparece en tu aplicación
GROUP_NAME="Nombre De Tu Grupo"

# Ruta al archivo CSV con los contactos
CSV_PATH="./contactos.csv"

# Nombre de la columna en el CSV que contiene los números de teléfono
PHONE_COLUMN="telefono"

# Nombre de la columna opcional en el CSV que contiene los nombres
NAME_COLUMN="nombre"

# Prefijo de país por defecto si el número en el CSV no incluye prefijo internacional (ej: 34 para España)
DEFAULT_COUNTRY_CODE="34"

# Retardos en milisegundos entre adición de contactos (Anti-spam / Anti-baneo)
MIN_DELAY_MS=5000
MAX_DELAY_MS=10000
