# Nombre exacto del grupo de WhatsApp tal cual aparece en tu aplicación
GROUP_NAME="Nombre De Tu Grupo"

# Ruta al archivo CSV con los contactos
CSV_PATH="./cd_cigales_20260808_jugador.csv"

# Nombre de la columna para el teléfono del tutor (WhatsApp y Google Contacts)
PHONE_COLUMN="Teléfono tutor"

# Nombre de la columna para el nombre del tutor (WhatsApp log)
NAME_COLUMN="Nombre tutor"

# Columnas específicas del CSV para la composición en Google Contacts:
# Formato: "Nombre tutor - Nombre Apellidos (Equipos)"
TUTOR_NAME_COLUMN="Nombre tutor"
PLAYER_NAME_COLUMN="Nombre"
PLAYER_SURNAME_COLUMN="Apellidos"
PLAYER_TEAM_COLUMN="Equipos"

# Prefijo de país por defecto si el número en el CSV no incluye prefijo internacional (ej: 34 para España)
DEFAULT_COUNTRY_CODE="34"

# Retardos en milisegundos entre adición de contactos (Anti-spam / Anti-baneo)
MIN_DELAY_MS=5000
MAX_DELAY_MS=10000

# Sincronización Opcional con Google Contacts
SYNC_GOOGLE_CONTACTS=false
GOOGLE_CREDENTIALS_PATH="./credentials.json"
GOOGLE_TOKEN_PATH="./token.json"
