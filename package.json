{
  "name": "wassapi",
  "version": "1.0.0",
  "description": "Script para añadir contactos desde un archivo CSV a un grupo de WhatsApp existente verificando previamente si ya forman parte del grupo.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:google": "SYNC_GOOGLE_CONTACTS=true node index.js",
    "dry-run": "DRY_RUN=true node index.js",
    "dry-run:google": "DRY_RUN=true SYNC_GOOGLE_CONTACTS=true node index.js"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "group-manager",
    "csv",
    "google-contacts"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "googleapis": "^174.0.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  }
}
